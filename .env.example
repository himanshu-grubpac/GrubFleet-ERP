# GrubPac ERP — copy to apps/backend/.env.development (backend) and apps/frontend/.env.local (frontend)

# Backend
# APP_ENV: development (local) | staging | preprod | production — set per deploy target
APP_ENV=development
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

DATABASE_URL=postgresql://grubpac:grubpac_dev@localhost:5432/grubpac_erp
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-use-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Frontend (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
