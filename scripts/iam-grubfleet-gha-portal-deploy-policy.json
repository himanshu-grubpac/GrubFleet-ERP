{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PortalBucketSync",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::grubfleet-portal-staging-662252246711",
        "arn:aws:s3:::grubfleet-portal-staging-662252246711/*",
        "arn:aws:s3:::grubfleet-portal-preprod-662252246711",
        "arn:aws:s3:::grubfleet-portal-preprod-662252246711/*",
        "arn:aws:s3:::grubfleet-portal-production-662252246711",
        "arn:aws:s3:::grubfleet-portal-production-662252246711/*"
      ]
    },
    {
      "Sid": "PortalCloudFrontInvalidate",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::662252246711:distribution/*"
    }
  ]
}
