{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "GrubPac ERP API",
    "description": "GrubPac ERP API — auth and administration (Phase 1 module RBAC).\n\nUse Postman environment files under docs/api/postman/ for local, staging, pre-prod, and production baseUrl.\n\nKeep in sync with docs/api/openapi.yaml when routes change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes for orchestration and local smoke checks.",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "GET /health — process liveness; no dependency checks."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "GET /health/ready — PostgreSQL (pool + Drizzle) and Redis. Returns 503 with ApiError body if any check is down."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "JWT access + rotating refresh tokens. Run Login first; set collection variables accessToken, refreshToken, organizationId from responses.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@grubpac.local\",\n  \"password\": \"ChangeMeDev123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "POST /auth/login — returns accessToken, refreshToken, tokenType Bearer, expiresIn (seconds)."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh",
            "description": "POST /auth/refresh — rotates refresh token; prior refresh is revoked."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "GET /auth/me — user, memberships (permissionKeys, moduleAccess, permissionRevision per org), union permissionKeys/moduleAccess. Refetch after RBAC changes; revision bumps when roles/assignments change."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout",
            "description": "POST /auth/logout — revoke refresh session(s); Bearer access token required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Administration",
      "description": "RBAC admin APIs — Bearer accessToken; org context via organizationId query and/or X-Organization-Id header. Writes require administration.manage.",
      "item": [
        {
          "name": "List organizations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/organizations?page=1&pageSize=20",
            "description": "GET /organizations — paginated orgs for caller."
          },
          "response": []
        },
        {
          "name": "Get organization by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/organizations/{{organizationId}}",
            "description": "GET /organizations/:id — member or system admin."
          },
          "response": []
        },
        {
          "name": "List users in org",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users?organizationId={{organizationId}}&page=1&pageSize=20",
            "description": "GET /users — requires administration.view."
          },
          "response": []
        },
        {
          "name": "Create user in org",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"email\": \"new.user@example.com\",\n  \"fullName\": \"New User\",\n  \"password\": \"ChangeMeDev123!\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/users?organizationId={{organizationId}}",
            "description": "POST /users — administration.manage; creates user + active membership."
          },
          "response": []
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}?organizationId={{organizationId}}",
            "description": "PATCH /users/:id — administration.manage; org-scoped."
          },
          "response": []
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/roles?organizationId={{organizationId}}&page=1",
            "description": "GET /roles — requires administration.view."
          },
          "response": []
        },
        {
          "name": "Create role (moduleAccess)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"name\": \"Fleet View Only\",\n  \"description\": \"Phase 1 module access example\",\n  \"moduleAccess\": [\n    { \"moduleId\": \"fleet_leasing\", \"accessLevel\": \"VIEW\" },\n    { \"moduleId\": \"administration\", \"accessLevel\": \"NONE\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/roles?organizationId={{organizationId}}",
            "description": "POST /roles — administration.manage; moduleAccess NONE|VIEW|MANAGE|FULL expands to permission keys (MANAGE = view + CRUD; FULL adds legacy .manage)."
          },
          "response": []
        },
        {
          "name": "Update role (moduleAccess)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fleet View Only (renamed)\",\n  \"moduleAccess\": [\n    { \"moduleId\": \"fleet_leasing\", \"accessLevel\": \"FULL\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}?organizationId={{organizationId}}",
            "description": "PATCH /roles/:id — administration.manage."
          },
          "response": []
        },
        {
          "name": "Assign role to user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}/assign?organizationId={{organizationId}}",
            "description": "POST /roles/:id/assign — administration.manage; delegation rules apply."
          },
          "response": []
        },
        {
          "name": "Unassign role from user",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}/assign?organizationId={{organizationId}}",
            "description": "DELETE /roles/:id/assign — administration.manage."
          },
          "response": []
        },
        {
          "name": "Role editor matrix",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/roles/editor-matrix?organizationId={{organizationId}}",
            "description": "GET /roles/editor-matrix — NONE/VIEW/MANAGE/FULL rows per sidebar module."
          },
          "response": []
        },
        {
          "name": "List modules",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/modules?organizationId={{organizationId}}",
            "description": "GET /modules — sidebar module registry for role editor."
          },
          "response": []
        },
        {
          "name": "List permissions catalog",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/permissions?organizationId={{organizationId}}&page=1",
            "description": "GET /permissions — requires administration.view."
          },
          "response": []
        },
        {
          "name": "List audit logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/audit?organizationId={{organizationId}}&page=1",
            "description": "GET /audit — requires administration.view."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fleet & Leasing",
      "description": "Lease contract wizard and lifecycle. Set leaseContractId from Create draft response.",
      "item": [
        {
          "name": "Create draft lease contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\"\n}"
            },
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts?organizationId={{organizationId}}",
            "description": "POST /fleet-leasing/lease-contracts — wizard entry (draft)."
          },
          "response": []
        },
        {
          "name": "Get contract review (wizard step 4)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/review?organizationId={{organizationId}}",
            "description": "GET .../review — client, lines, terms, pricingEvaluation, reviewAction, messages, canSubmit."
          },
          "response": []
        },
        {
          "name": "Terms evaluation (wizard step 3)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/terms/evaluation?organizationId={{organizationId}}",
            "description": "GET .../terms/evaluation — pricing engine preview."
          },
          "response": []
        },
        {
          "name": "Update contract terms (wizard step 3)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-09-15\",\n  \"termMonths\": 24,\n  \"securityDeposit\": \"210000.00\",\n  \"billingFrequency\": \"monthly\"\n}"
            },
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/terms?organizationId={{organizationId}}",
            "description": "PUT .../terms — saves step 3; returns contract + pricingEvaluation."
          },
          "response": []
        },
        {
          "name": "Submit for approval (wizard step 4)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/submit?organizationId={{organizationId}}",
            "description": "POST .../submit — when reviewAction is submit_for_approval; status pending_approval + approval request."
          },
          "response": []
        },
        {
          "name": "Confirm contract (wizard step 4)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/confirm?organizationId={{organizationId}}",
            "description": "POST .../confirm — when reviewAction is confirm_contract; activates or awaiting_assets. Response includes confirmation summary for success screen."
          },
          "response": []
        },
        {
          "name": "Get contract confirmation (post-wizard)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/confirmation?organizationId={{organizationId}}",
            "description": "GET .../confirmation — allocationByLine, infoMessages; active, awaiting_assets, or approved."
          },
          "response": []
        },
        {
          "name": "Get lease contract detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}?organizationId={{organizationId}}",
            "description": "GET .../{id} — subtitle, statusTags, statusBanner, lifecycleLogs, availableActions, returnProgress, terminatedAt."
          },
          "response": []
        },
        {
          "name": "Edit lease contract",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{fleetClientId}}\",\n  \"startDate\": \"2026-09-15\",\n  \"termMonths\": 24,\n  \"securityDeposit\": \"96000.00\",\n  \"billingFrequency\": \"monthly\",\n  \"additionalTerms\": \"Standard fleet SLA applies.\",\n  \"amcTier\": \"Gold\",\n  \"assetLines\": [\n    {\n      \"assetClass\": \"Sedan\",\n      \"committedQuantity\": 10,\n      \"ratePerVehicleMonth\": \"34500.00\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}?organizationId={{organizationId}}",
            "description": "PATCH .../{id} — edit client, terms, asset lines, optional vehicleIds. Blocked on closed/concluded/pending_termination. Returns detail + pricingEvaluation when terms/lines change."
          },
          "response": []
        },
        {
          "name": "Deactivate lease contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/deactivate?organizationId={{organizationId}}",
            "description": "POST .../deactivate — active only; onHold true, billing continues."
          },
          "response": []
        },
        {
          "name": "Reactivate lease contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/reactivate?organizationId={{organizationId}}",
            "description": "POST .../reactivate — direct to active/awaiting_assets; no approval."
          },
          "response": []
        },
        {
          "name": "Pause lease contract billing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/pause-billing?organizationId={{organizationId}}",
            "description": "POST .../pause-billing — requires returnProgress.canPauseBilling."
          },
          "response": []
        },
        {
          "name": "Request lease contract termination",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/request-termination?organizationId={{organizationId}}",
            "description": "POST .../request-termination — from deactivated/billing_paused; pending Contract Admin."
          },
          "response": []
        },
        {
          "name": "Approve lease contract termination",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/approve-termination?organizationId={{organizationId}}",
            "description": "POST .../approve-termination — closes contract; deposit settle is messaging stub until Finance integration."
          },
          "response": []
        },
        {
          "name": "Renew lease contract (Flow 04)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/renew?organizationId={{organizationId}}",
            "description": "POST .../renew — draft renewal with null end date until terms set."
          },
          "response": []
        },
        {
          "name": "List vehicle allocations (hub)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/vehicle-allocations?organizationId={{organizationId}}&page=1",
            "description": "GET /fleet-leasing/vehicle-allocations — org allocation hub."
          },
          "response": []
        },
        {
          "name": "Allocate vehicle to contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{fleetVehicleId}}\",\n  \"notifiedStakeholders\": [\"ops@example.com\"]\n}"
            },
            "url": "{{baseUrl}}/fleet-leasing/lease-contracts/{{leaseContractId}}/vehicle-allocations?organizationId={{organizationId}}",
            "description": "POST .../vehicle-allocations — Flow 02 allocate/reassign."
          },
          "response": []
        },
        {
          "name": "List returns hub",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-organization-id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/fleet-leasing/returns?organizationId={{organizationId}}&page=1",
            "description": "GET /fleet-leasing/returns — Flow 06 hub."
          },
          "response": []
        }
      ]
    }
  ],
